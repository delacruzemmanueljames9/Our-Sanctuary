# ====================================================================
# OUR SANCTUARY — ENVIRONMENT CONFIGURATION
# ====================================================================

# 1. Gate Authentication (Shared 6-digit PIN between Emman & Lei)
# NEVER put this in client-side NEXT_PUBLIC_* variables.
# Default development PIN: 110826 (representing their sanctuary date)
SANCTUARY_GATE_PIN=110826

# 2. Super Administrator Access (EMMAN ONLY)
# Completely separate secret code for Emman's exclusive control center.
# Lei never receives administrator privileges.
EMMAN_ADMIN_SECRET=emman_celestial_admin_2026

# 3. Personal Journal Security Keys
# Used to isolate private journal entries between Emman and Lei.
EMMAN_JOURNAL_PIN=2408
LEI_JOURNAL_PIN=1509

# 4. JWT & Cookie Encryption Secret
SANCTUARY_SESSION_SECRET=sanctuary_super_secret_jwt_encryption_key_celestial_wings_2026

# 5. Supabase Configuration (Optional for initial run, mock fallback active)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 6. Mochi AI Companion (Phase 2 Integration)
# Leave blank to run Mochi in Phase 1 graceful offline / sanctuary wisdom mode.
GEMINI_API_KEY=
# or OPENAI_API_KEY=
